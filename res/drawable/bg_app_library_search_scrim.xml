<!-- Fade behind the App Library's search box, so the box stays legible against the rows that
     scroll under it. Same shape as the one behind the search box in Settings. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/app_library_search_scrim"
        android:endColor="@android:color/transparent" />
</shape>
