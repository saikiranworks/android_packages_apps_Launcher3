<!-- A big (2x2) FolderIcon used for the auto-categorized app-drawer folders ("Caddy" mode).
     Fills its RecyclerView tile (match_parent) so the big preview has room. -->
<com.android.launcher3.folder.FolderIcon
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:focusable="true"
    android:defaultFocusHighlightEnabled="false">
    <com.android.launcher3.views.DoubleShadowBubbleTextView
        style="@style/BaseIcon.AllApps"
        android:id="@+id/folder_icon_name"
        android:focusable="false"
        android:layout_gravity="top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        launcher:iconDisplay="all_apps" />
</com.android.launcher3.folder.FolderIcon>
