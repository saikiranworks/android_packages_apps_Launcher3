<!-- One app on a line of its own, icon then name, for the App Library's search list. -->
<com.android.launcher3.BubbleTextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/icon"
    android:layout_width="match_parent"
    android:layout_height="@dimen/all_apps_row_height"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:gravity="start|center_vertical"
    android:paddingStart="@dimen/all_apps_row_horizontal_padding"
    android:paddingEnd="@dimen/app_library_row_end_padding"
    android:singleLine="true"
    android:ellipsize="end"
    android:textAlignment="viewStart"
    android:textColor="?android:attr/textColorPrimary"
    launcher:iconDisplay="search_result_app_row"
    launcher:layoutHorizontal="true"
    launcher:centerVertically="true" />
