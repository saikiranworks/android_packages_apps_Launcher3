<com.android.launcher3.search.universal.SpotlightView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    launcher:layout_ignoreInsets="true">

    <FrameLayout
        android:id="@+id/spotlight_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/spotlight_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1F000000" />

        <LinearLayout
            android:id="@+id/spotlight_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spotlight_margin">

            <LinearLayout
                android:id="@+id/spotlight_field"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spotlight_field_height"
                android:elevation="6dp"
                android:background="@drawable/bg_spotlight_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_allapps_search"
                    android:tint="#99FFFFFF" />

                <EditText
                    android:id="@+id/spotlight_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/spotlight_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textColorHint="#99FFFFFF"
                    android:textSize="17sp" />

                <ImageView
                    android:id="@+id/spotlight_mic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/spotlight_voice"
                    android:src="@drawable/ic_mic_themed"
                    android:tint="#B3FFFFFF" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/spotlight_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_spotlight_card">

                <!-- What's behind the card, blurred, so the card reads as frosted glass. Sized to
                     the results in code, as its screen-sized image would stretch the card. -->
                <ImageView
                    android:id="@+id/spotlight_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:foreground="#4D2A2A30"
                    android:importantForAccessibility="no"
                    android:scaleType="matrix" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/spotlight_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="14dp" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</com.android.launcher3.search.universal.SpotlightView>
